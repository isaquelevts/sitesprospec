{
  "rewrites": [
    {
      "source": "/ebooks",
      "destination": "/ebooks/index.html"
    },
    {
      "source": "/ebooks/",
      "destination": "/ebooks/index.html"
    },
    {
      "source": "/doloteaobra",
      "destination": "/doloteaobra/index.html"
    },
    {
      "source": "/doloteaobra/",
      "destination": "/doloteaobra/index.html"
    },
    {
      "source": "/doloteaobra/obrigado",
      "destination": "/doloteaobra/obrigado/index.html"
    },
    {
      "source": "/doloteaobra/obrigado/",
      "destination": "/doloteaobra/obrigado/index.html"
    },
    {
      "source": "/doloteaobra-verde",
      "destination": "/doloteaobra/index.html"
    },
    {
      "source": "/doloteaobra-verde/",
      "destination": "/doloteaobra/index.html"
    },
    {
      "source": "/granpara",
      "destination": "/granpara/index.html"
    },
    {
      "source": "/granpara/",
      "destination": "/granpara/index.html"
    },
    {
      "source": "/dranayane",
      "destination": "/dranayane/index.html"
    },
    {
      "source": "/dranayane/",
      "destination": "/dranayane/index.html"
    },
    {
      "source": "/dranayane-intermediario",
      "destination": "/dranayane-intermediario/index.html"
    },
    {
      "source": "/dranayane-intermediario/",
      "destination": "/dranayane-intermediario/index.html"
    },
    {
      "source": "/dranayane-basico",
      "destination": "/dranayane-basico/index.html"
    },
    {
      "source": "/dranayane-basico/",
      "destination": "/dranayane-basico/index.html"
    },
    {
      "source": "/bigbang",
      "destination": "/bigbang/index.html"
    },
    {
      "source": "/bigbang/",
      "destination": "/bigbang/index.html"
    },
    {
      "source": "/potencialize/",
      "destination": "/potencialize/index.html"
    },
    {
      "source": "/caiomartins/",
      "destination": "/caiomartins/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/potencialize",
      "destination": "/potencialize/",
      "permanent": true
    },
    {
      "source": "/potencialize/sobre",
      "destination": "/potencialize/sobre/",
      "permanent": true
    },
    {
      "source": "/caiomartins",
      "destination": "/caiomartins/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/ebooks/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/ebooks/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
